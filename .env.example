# shared password for the AeroLab page (leave empty for none)
AEROLAB_PASSWORD=change-me
# worker (optional; defaults: half the cores in parallel runs, the rest as threads per run)
AEROLAB_WORKER_SLOTS=
AEROLAB_JOB_THREADS=
AEROLAB_JOB_MEM_GB=
# image build (docker compose up -d --build)
AEROLAB_MUMPS=1
# "native" tunes the 3D kernel to the CPU that builds the image; x86-64-v2 runs on any 64-bit PC
AEROLAB_NATIVE_MARCH=native
